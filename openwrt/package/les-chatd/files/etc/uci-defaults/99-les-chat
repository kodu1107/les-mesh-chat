#!/bin/sh

NODE_DIR=/etc/les-chat
NODE_ID_FILE="$NODE_DIR/node-id"
CALLSIGN_FILE="$NODE_DIR/callsign"

mkdir -p "$NODE_DIR"

if [ ! -s "$NODE_ID_FILE" ]; then
	umask 077
	{
		od -An -N8 -tx1 /dev/urandom | tr -d ' \n'
		echo
	} > "$NODE_ID_FILE"
fi

chmod 600 "$NODE_ID_FILE"

# Migrate an explicitly configured nickname into the persistent identity
# store. The store is outside /etc/config so package updates cannot replace it.
configured_callsign=$(uci -q get les-chat.main.callsign || true)
case "$configured_callsign" in
	''|auto)
		;;
	*)
		umask 077
		printf '%s\n' "$configured_callsign" > "$CALLSIGN_FILE"
		chmod 600 "$CALLSIGN_FILE"
		;;
esac

if [ -e "$NODE_DIR/time-authority" ]; then
	uci -q set les-chat.main.time_sync_mode='authority' || true
else
	uci -q get les-chat.main.time_sync_mode >/dev/null 2>&1 || \
		uci -q set les-chat.main.time_sync_mode='client' || true
fi
uci -q get les-chat.main.time_authority_id >/dev/null 2>&1 || \
	uci -q set les-chat.main.time_authority_id='' || true
uci -q commit les-chat || true

exit 0

#!/bin/sh /etc/rc.common

# Keep LES Mesh Chat traffic on the HaLow interface when LAN and HaLow use
# overlapping IPv4 prefixes (the default OpenMANET 10.41.0.0/16 layout).
START=94
STOP=09

TABLE=1000
PRIORITY=1000
MTU=1200

mesh_interface() {
	config_load les-chat
	config_get interface main discovery_interface auto
	if [ "$interface" = auto ]; then
		[ -e /sys/class/net/br-ahwlan ] || return 0
		interface=br-ahwlan
	fi
	echo "$interface"
}

mesh_route() {
	interface=$1
	ip -4 route show dev "$interface" proto kernel scope link 2>/dev/null |
		awk '$1 ~ /^[0-9]/ { print $1; exit }'
}

mesh_source() {
	interface=$1
	ip -4 -o addr show dev "$interface" scope global 2>/dev/null |
		awk '{ split($4, parts, "/"); print parts[1]; exit }'
}

apply_route() {
	interface=$1
	route=$(mesh_route "$interface")
	source=$(mesh_source "$interface")
	[ -n "$route" ] && [ -n "$source" ] || return 1

	ip rule del pref "$PRIORITY" 2>/dev/null || true
	ip route flush table "$TABLE" >/dev/null 2>&1 || true
	ip route replace table "$TABLE" "$route" \
		dev "$interface" src "$source" mtu "$MTU" advmss 1160
	ip rule add pref "$PRIORITY" from "$source/32" lookup "$TABLE"
}

start() {
	local interface attempt
	interface=$(mesh_interface)
	[ -n "$interface" ] || return 0

	# Network interfaces may receive their address after rc.common starts. Retry
	# briefly and let the interface trigger below repair the route later as well.
	attempt=0
	while [ "$attempt" -lt 15 ]; do
		if apply_route "$interface"; then
			return 0
		fi
		attempt=$((attempt + 1))
		sleep 1
	done

	logger -t les-chat-routing \
		"$interface has no usable IPv4 route or address"
	return 0
}

stop() {
	ip rule del pref "$PRIORITY" 2>/dev/null || true
	ip route flush table "$TABLE" >/dev/null 2>&1 || true
}

service_triggers() {
	local interface
	interface=$(mesh_interface)
	[ -n "$interface" ] || return 0
	procd_add_interface_trigger "interface.*.up" "$interface" \
		/etc/init.d/les-chat-routing restart
	procd_add_interface_trigger "interface.*.down" "$interface" \
		/etc/init.d/les-chat-routing stop
}

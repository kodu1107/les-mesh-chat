#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

SERVICE=/usr/sbin/les-chatd
NODE_ID_FILE=/etc/les-chat/node-id
CALLSIGN_FILE=/etc/les-chat/callsign

firewall_rule_matches() {
	section=$1
	protocol=$2
	[ "$(uci -q get firewall.$section.src 2>/dev/null)" = ahwlan ] || return 1
	[ "$(uci -q get firewall.$section.proto 2>/dev/null)" = "$protocol" ] || return 1
	[ "$(uci -q get firewall.$section.dest_port 2>/dev/null)" = 7777 ] || return 1
	[ "$(uci -q get firewall.$section.target 2>/dev/null)" = ACCEPT ] || return 1
}

ensure_firewall_rules() {
	command -v uci >/dev/null 2>&1 || return 0

	local changed=0
	for rule in tcp udp; do
		section="les_chatd_$rule"
		if ! firewall_rule_matches "$section" "$rule"; then
			uci -q delete "firewall.$section" || true
			uci -q set "firewall.$section=rule" || true
			uci -q set "firewall.$section.name=LES Mesh Chat $rule" || true
			uci -q set "firewall.$section.src=ahwlan" || true
			uci -q set "firewall.$section.proto=$rule" || true
			uci -q set "firewall.$section.dest_port=7777" || true
			uci -q set "firewall.$section.target=ACCEPT" || true
			changed=1
		fi
	done

	if [ "$changed" -eq 1 ]; then
		uci -q commit firewall || true
		[ -x /etc/init.d/firewall ] && \
			/etc/init.d/firewall reload >/dev/null 2>&1 || true
	fi
}

load_identity_value() {
	file=$1
	[ -s "$file" ] || return 1
	sed -n '1{s/[\r\n]*$//;p;}' "$file"
}

save_identity_value() {
	file=$1
	value=$2
	[ -n "$value" ] || return 1
	mkdir -p "$(dirname "$file")"
	umask 077
	printf '%s\n' "$value" > "$file"
	chmod 600 "$file"
}

load_node_id() {
	load_identity_value "$NODE_ID_FILE" | tr -d ' \t\r\n'
}

resolve_node_id() {
	configured=$1
	if [ -n "$configured" ] && [ "$configured" != "auto" ]; then
		save_identity_value "$NODE_ID_FILE" "$configured" || true
		echo "$configured"
		return 0
	fi

	persistent=$(load_node_id 2>/dev/null || true)
	if [ -n "$persistent" ]; then
		echo "$persistent"
		return 0
	fi

	# uci-defaults normally creates this file. Keep booting safely if it was
	# removed during an image upgrade or an incomplete first boot.
	persistent=$(od -An -N8 -tx1 /dev/urandom 2>/dev/null | tr -d ' \n' || true)
	[ -n "$persistent" ] || return 1
	save_identity_value "$NODE_ID_FILE" "$persistent" || return 1
	echo "$persistent"
}

resolve_callsign() {
	configured=$1
	if [ -n "$configured" ] && [ "$configured" != "auto" ]; then
		save_identity_value "$CALLSIGN_FILE" "$configured" || true
		echo "$configured"
		return 0
	fi

	persistent=$(load_identity_value "$CALLSIGN_FILE" 2>/dev/null || true)
	if [ -n "$persistent" ]; then
		# Restore the visible UCI value as well, so LuCI does not ask again after
		# a package update replaced the default config with callsign='auto'.
		if [ "$configured" != "$persistent" ]; then
			uci -q set les-chat.main.callsign="$persistent" || true
			uci -q commit les-chat || true
		fi
		echo "$persistent"
		return 0
	fi

	hostname
}

detect_discovery_interface() {
	if [ -e /sys/class/net/br-ahwlan ]; then
		echo br-ahwlan
		return 0
	fi

	return 1
}

start_service() {
	ensure_firewall_rules
	if [ -e /sys/class/net/br-ahwlan ] &&
	   [ -x /etc/init.d/les-chat-routing ]; then
		/etc/init.d/les-chat-routing enable >/dev/null 2>&1 || true
		/etc/init.d/les-chat-routing restart >/dev/null 2>&1 || true
	fi
	config_load les-chat

	config_get_bool enabled main enabled 1
	[ "$enabled" -eq 1 ] || return 0

	config_get node_id main node_id auto
	node_id="$(resolve_node_id "$node_id")"
	[ -n "$node_id" ] || {
		logger -t les-chatd "node ID is not configured"
		return 1
	}

	config_get callsign main callsign auto
	callsign="$(resolve_callsign "$callsign")"
	config_get bind main bind 0.0.0.0
	config_get port main port 7777
	config_get discovery_address main discovery_address 255.255.255.255
	config_get discovery_interface main discovery_interface auto
	if [ "$discovery_interface" = "auto" ]; then
		discovery_interface="$(detect_discovery_interface)"
	fi
	config_get discovery_port main discovery_port 7777
	config_get time_sync_mode main time_sync_mode client
	case "$time_sync_mode" in
		off|authority|client) ;;
		*) time_sync_mode=client ;;
	esac
	config_get time_authority_id main time_authority_id ''
	config_get database main database /overlay/les-chat/messages.db

	mkdir -p "$(dirname "$database")"

	procd_open_instance
	procd_set_param command "$SERVICE" \
		--node-id "$node_id" \
		--callsign "$callsign" \
		--bind "$bind" \
		--port "$port" \
		--discovery-address "$discovery_address" \
		--discovery-port "$discovery_port" \
		--time-sync-mode "$time_sync_mode" \
		--database "$database"
	[ -z "$time_authority_id" ] || procd_append_param command \
		--time-authority-id "$time_authority_id"
	[ -z "$discovery_interface" ] || procd_append_param command \
		--discovery-interface "$discovery_interface"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

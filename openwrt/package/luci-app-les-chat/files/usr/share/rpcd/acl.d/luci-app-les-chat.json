{
	"luci-app-les-chat": {
		"description": "Grant access to LES Mesh Chat status, peers, and chat",
		"read": {
			"ubus": {
				"luci.leschat": [
					"healthz",
					"status",
					"peers",
					"messages"
				]
			},
			"uci": [
				"les-chat"
			]
		},
		"write": {
			"ubus": {
				"luci.leschat": [
					"send"
				]
			}
		}
	},
	"luci-app-les-chat-settings": {
		"description": "Grant access to LES Mesh Chat settings",
		"read": {
			"uci": [
				"les-chat"
			]
		},
		"write": {
			"uci": [
				"les-chat"
			],
			"ubus": {
				"service": [
					"list",
					"event"
				]
			},
			"file": {
				"/etc/init.d/les-chatd": [ "exec" ]
			}
		}
	}
}

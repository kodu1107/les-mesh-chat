#!/bin/sh

# shellcheck disable=SC1091
. /usr/share/libubox/jshn.sh

sanitize_port() {
	port=$1
	case "$port" in
		''|*[!0-9]*)
			echo 7777
			return
			;;
	esac
	if [ "$port" -lt 1 ] || [ "$port" -gt 65535 ]; then
		echo 7777
		return
	fi
	echo "$port"
}

uci_get_default() {
	value=$(uci -q get "les-chat.main.$1")
	if [ -n "$value" ]; then
		echo "$value"
	else
		echo "$2"
	fi
}

daemon_port() {
	sanitize_port "$(uci_get_default port 7777)"
}

database_path() {
	uci_get_default database /overlay/les-chat/messages.db
}

identity_file_value() {
	file=$1
	[ -s "$file" ] || return 1
	sed -n '1{s/[\r\n]*$//;p;}' "$file"
}

effective_node_id() {
	configured=$(uci -q get les-chat.main.node_id || true)
	if [ -n "$configured" ] && [ "$configured" != "auto" ]; then
		echo "$configured"
		return
	fi
	persistent=$(identity_file_value /etc/les-chat/node-id 2>/dev/null || true)
	persistent=$(printf '%s' "$persistent" | tr -d ' \t\r\n')
	[ -n "$persistent" ] && echo "$persistent" || echo auto
}

effective_callsign() {
	persistent=$(identity_file_value /etc/les-chat/callsign 2>/dev/null || true)
	if [ -n "$persistent" ]; then
		echo "$persistent"
		return
	fi
	configured=$(uci -q get les-chat.main.callsign || true)
	if [ -n "$configured" ] && [ "$configured" != "auto" ]; then
		echo "$configured"
	else
		hostname
	fi
}

callsign_configured() {
	[ -n "$(identity_file_value /etc/les-chat/callsign 2>/dev/null || true)" ] && return 0
	configured=$(uci -q get les-chat.main.callsign || true)
	[ -n "$configured" ] && [ "$configured" != "auto" ]
}

database_bytes() {
	path=$(database_path)
	if [ -f "$path" ]; then
		stat -c %s "$path" 2>/dev/null || echo 0
	else
		echo 0
	fi
}

daemon_running() {
	pidof les-chatd >/dev/null 2>&1
}

fetch_local() {
	path=$1
	port=$(daemon_port)
	wget -qO- -T 2 "http://127.0.0.1:${port}${path}" 2>/dev/null || true
}

dump_unreachable() {
	json_init
	json_add_boolean running 0
	json_add_boolean healthz_ok 0
	json_add_string error "daemon_unreachable"
	json_add_string node_id "$(effective_node_id)"
	json_add_string callsign "$(effective_callsign)"
	if callsign_configured; then
		json_add_boolean callsign_configured 1
	else
		json_add_boolean callsign_configured 0
	fi
	if [ -s /etc/les-chat/node-id ]; then
		json_add_boolean node_id_persistent 1
	else
		json_add_boolean node_id_persistent 0
	fi
	json_add_string bind_address "$(uci_get_default bind 0.0.0.0)"
	json_add_int port "$(daemon_port)"
	json_add_string database "$(database_path)"
	json_add_int database_bytes "$(database_bytes)"
	json_dump
}

call_healthz() {
	body=$(fetch_local /healthz)
	json_init
	if [ -n "$body" ] && json_load "$body"; then
		json_add_boolean running 1
		json_add_boolean healthz_ok 1
		json_dump
		return
	fi

	json_init
	if daemon_running; then
		json_add_boolean running 1
	else
		json_add_boolean running 0
	fi
	json_add_boolean healthz_ok 0
	json_add_string error "daemon_unreachable"
	json_dump
}

call_status() {
	body=$(fetch_local /api/v1/status)
	if [ -n "$body" ] && json_load "$body"; then
		if daemon_running; then
			json_add_boolean running 1
		else
			json_add_boolean running 0
		fi
		json_add_boolean healthz_ok 1
		if callsign_configured; then
			json_add_boolean callsign_configured 1
		else
			json_add_boolean callsign_configured 0
		fi
		if [ -s /etc/les-chat/node-id ]; then
			json_add_boolean node_id_persistent 1
		else
			json_add_boolean node_id_persistent 0
		fi
		json_add_string database "$(database_path)"
		json_add_int database_bytes "$(database_bytes)"
		json_dump
		return
	fi

	dump_unreachable
}

call_peers() {
	body=$(fetch_local /api/v1/peers)
	if [ -n "$body" ] && json_load "$body"; then
		if daemon_running; then
			json_add_boolean running 1
		else
			json_add_boolean running 0
		fi
		json_dump
		return
	fi

	json_init
	json_add_boolean running 0
	json_add_string error "daemon_unreachable"
	json_add_array peers
	json_close_array
	json_add_int count 0
	json_dump
}

call_messages() {
	body=$(fetch_local /api/v1/messages)
	if [ -n "$body" ] && json_load "$body"; then
		if daemon_running; then
			json_add_boolean running 1
		else
			json_add_boolean running 0
		fi
		json_dump
		return
	fi

	json_init
	json_add_boolean running 0
	json_add_string error "daemon_unreachable"
	json_add_array messages
	json_close_array
	json_add_int count 0
	json_dump
}

call_send() {
	input=$(cat)
	if ! json_load "$input"; then
		json_init
		json_add_string error "invalid_json"
		json_dump
		return
	fi

	json_get_var body body
	if [ -z "$body" ]; then
		json_init
		json_add_string error "message_empty"
		json_dump
		return
	fi

	json_init
	json_add_string body "$body"
	payload=$(json_dump)
	port=$(daemon_port)
	response=$(
		wget -qO- -T 2 \
			--post-data="$payload" \
			--header='Content-Type: application/json' \
			"http://127.0.0.1:${port}/api/v1/messages" 2>/dev/null || true
	)

	if [ -n "$response" ] && json_load "$response"; then
		json_dump
		return
	fi

	json_init
	json_add_string error "daemon_unreachable"
	json_dump
}

call_restart() {
	# The visible action is an explicit request to run the service, so recover
	# from an accidentally disabled UCI flag as well as a crashed process.
	uci -q set les-chat.main.enabled='1' || true
	uci -q commit les-chat || true
	/etc/init.d/les-chatd enable >/dev/null 2>&1 || true
	if /etc/init.d/les-chatd restart >/dev/null 2>&1; then
		json_init
		json_add_boolean ok 1
		json_add_string status "restarting"
		json_dump
		return
	fi

	json_init
	json_add_boolean ok 0
	json_add_string error "restart_failed"
	json_dump
}

case "$1" in
	list)
		json_init
		json_add_object healthz
		json_close_object
		json_add_object status
		json_close_object
		json_add_object peers
		json_close_object
		json_add_object messages
		json_close_object
		json_add_object send
		json_close_object
		json_add_object restart
		json_close_object
		json_dump
		;;
	call)
		case "$2" in
			healthz)
				call_healthz
				;;
			status)
				call_status
				;;
			peers)
				call_peers
				;;
			messages)
				call_messages
				;;
			send)
				call_send
				;;
			restart)
				call_restart
				;;
		esac
		;;
esac

#!/bin/sh

set -eu

default_feed_base_url='@FEED_BASE_URL@'
supported_release='@OPENWRT_RELEASE@'
supported_revision='r28739-d9340319c6'
channel=stable
trusted_key_id=9db1776b78018b98

[ "$#" -le 1 ] || {
	echo "usage: $0 [FEED_BASE_URL]" >&2
	exit 2
}

feed_base_url=${1:-$default_feed_base_url}

case "$feed_base_url" in
	http://*|https://*) ;;
	*)
		echo "feed URL must start with http:// or https://" >&2
		exit 2
		;;
esac

[ -r /etc/openwrt_release ] || {
	echo "this installer must run on OpenWrt" >&2
	exit 1
}

# shellcheck disable=SC1091
. /etc/openwrt_release

release_is_supported=0
if [ "${DISTRIB_RELEASE:-}" = "$supported_release" ]; then
	release_is_supported=1
elif [ "${DISTRIB_RELEASE:-}" = 24.10 ] && \
	[ "${DISTRIB_REVISION:-}" = "$supported_revision" ]; then
	# OpenMANET 1.7.0 shortens the 24.10.2 release label to 24.10,
	# while retaining the exact upstream OpenWrt revision.
	release_is_supported=1
fi

[ "$release_is_supported" -eq 1 ] || {
	echo "unsupported OpenWrt release: ${DISTRIB_RELEASE:-unknown}" >&2
	echo "revision: ${DISTRIB_REVISION:-unknown}" >&2
	echo "expected: $supported_release ($supported_revision)" >&2
	exit 1
}

package_arch=$(
	opkg print-architecture | awk '
		$2 == "aarch64_cortex-a72" || $2 == "aarch64_cortex-a76" {
			selected = $2
		}
		END { print selected }
	'
)

[ -n "$package_arch" ] || {
	echo "this feed supports Raspberry Pi 4 and Raspberry Pi 5 only" >&2
	exit 1
}

key_tmp=/tmp/les-chat-opkg.pub
wget -q "$feed_base_url/opkg.pub" -O "$key_tmp"
key_id=$(usign -F -p "$key_tmp")
[ "$key_id" = "$trusted_key_id" ] || {
	echo "untrusted LES Mesh Chat signing key: ${key_id:-unreadable}" >&2
	exit 1
}

cp "$key_tmp" "/etc/opkg/keys/$key_id"
chmod 0644 "/etc/opkg/keys/$key_id"

feed_url="$feed_base_url/$supported_release/$channel/$package_arch"
sed -i '/^src\/gz les_chat_/d' /etc/opkg/customfeeds.conf
printf 'src/gz les_chat_%s %s\n' "$channel" "$feed_url" >> \
	/etc/opkg/customfeeds.conf

download_dir=/tmp/les-chat-feed-install.$$
index_file=$download_dir/Packages
signature_file=$download_dir/Packages.sig
trap 'rm -rf "$download_dir" "$key_tmp"' EXIT INT TERM
mkdir -p "$download_dir"

wget -q "$feed_url/Packages" -O "$index_file"
wget -q "$feed_url/Packages.sig" -O "$signature_file"
usign -V -m "$index_file" -p "$key_tmp" -x "$signature_file"

package_number=0
for package_name in \
	libgcc1 \
	libstdcpp6 \
	zlib \
	libevent2-7 \
	libjson-c5 \
	libsqlite3-0 \
	les-chatd
do
	filename=$(
		awk -v wanted="$package_name" '
			$1 == "Package:" { selected = ($2 == wanted) }
			selected && $1 == "Filename:" { print $2; exit }
		' "$index_file"
	)
	filename=${filename#./}
	case "$filename" in
		''|*/*|*[!A-Za-z0-9._+~-]*|*.ipk?*)
			echo "invalid filename for $package_name: ${filename:-missing}" >&2
			exit 1
			;;
		*.ipk) ;;
		*)
			echo "invalid filename for $package_name: $filename" >&2
			exit 1
			;;
	esac
	checksum=$(
		awk -v wanted="$package_name" '
			$1 == "Package:" { selected = ($2 == wanted) }
			selected && $1 == "SHA256sum:" { print $2; exit }
		' "$index_file"
	)
	case "$checksum" in
		''|*[!0-9a-f]*)
			echo "invalid checksum for $package_name" >&2
			exit 1
			;;
	esac
	package_number=$((package_number + 1))
	download_path=$download_dir/$package_number-$filename
	wget -q "$feed_url/$filename" \
		-O "$download_path"
	actual_checksum=$(sha256sum "$download_path" | awk '{ print $1 }')
	[ "$actual_checksum" = "$checksum" ] || {
		echo "checksum verification failed for $package_name" >&2
		exit 1
	}
done

# Every dependency is a verified local file, so opkg never contacts the
# firmware's external OpenMANET or OpenWrt feeds during installation.
opkg install "$download_dir"/*.ipk

if [ -x /etc/uci-defaults/99-les-chat ]; then
	/etc/uci-defaults/99-les-chat
fi

/etc/init.d/les-chatd enable
/etc/init.d/les-chatd restart

sleep 1
wget -qO- http://127.0.0.1:7777/healthz
echo
echo "LES Mesh Chat is available on port 7777."

rm -rf "$download_dir" "$key_tmp"
trap - EXIT INT TERM

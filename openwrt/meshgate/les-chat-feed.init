#!/bin/sh /etc/rc.common

# These variables are consumed by OpenWrt's /etc/rc.common wrapper.
# shellcheck disable=SC2034
START=95
# shellcheck disable=SC2034
STOP=10
# shellcheck disable=SC2034
USE_PROCD=1

start_service() {
	# OpenWrt ash supports local variables in service functions.
	# shellcheck disable=SC3043
	local document_root port

	config_load les-chat-feed
	config_get document_root main root /srv/les-chat-feed
	config_get port main port 8088

	procd_open_instance
	if [ -x /usr/sbin/uhttpd ]; then
		procd_set_param command /usr/sbin/uhttpd \
			-f -h "$document_root" -p "0.0.0.0:$port"
	elif /bin/busybox --list 2>/dev/null | grep -qx httpd; then
		procd_set_param command /bin/busybox httpd \
			-f -p "$port" -h "$document_root"
	else
		logger -t les-chat-feed "uhttpd or the BusyBox httpd applet is required"
		return 1
	fi
	procd_set_param respawn 3600 5 5
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger les-chat-feed
}
